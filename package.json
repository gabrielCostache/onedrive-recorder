{
  "name": "onedrive-recorder",
  "version": "0.3.0",
  "private": true,
  "description": "Screen recording saved directly in a locally synced OneDrive folder",
  "author": "OneDrive Recorder contributors",
  "main": "src/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:desktop": "node test/desktop-smoke.cjs",
    "check": "node scripts/check.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "44.4.4",
    "electron-builder": "26.15.3",
    "@playwright/test": "^1.63.0"
  },
  "build": {
    "appId": "com.onedrive.recorder.desktop",
    "productName": "OneDrive Recorder",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Înregistrează vocea ta în videoclipuri, când activezi microfonul."
      }
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "src/french-bulldog-camera.ico"
    },
    "portable": {
      "artifactName": "OneDrive-Recorder-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "maintainer": "OneDrive Recorder contributors"
    }
  }
}
